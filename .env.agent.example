# Copy to .env.agent on each participant's own PC. This file remains local.
PERSONAL_CONTEXT_AGENT_GATEWAY_URL=wss://agents.example.com
PERSONAL_CONTEXT_AGENT_WORKDIR=/home/example/github/project
PERSONAL_CONTEXT_AGENT_WORKSPACE_DIR=/home/example/.local/state/personal-context-hub/agent-workspaces
PERSONAL_CONTEXT_AGENT_NAME=Frontend Codex
PERSONAL_CONTEXT_AGENT_CAPABILITIES=frontend,ui,react,css,test
PERSONAL_CONTEXT_AGENT_CONCURRENCY=1
PERSONAL_CONTEXT_AGENT_MODEL=gpt-5.6-sol
PERSONAL_CONTEXT_AGENT_REASONING_EFFORT=medium
# Optional on Linux. Windows stores the Worker credential with CurrentUser DPAPI.
# PERSONAL_CONTEXT_AGENT_CREDENTIAL_PATH=/home/example/.local/share/personal-context-hub/agent-worker.json
