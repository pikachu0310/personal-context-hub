{
  "name": "personal-context-hub",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "IDO Engine, Client, Dashboard and Discord plugin workspace.",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build:desktop": "npm run build:ido && node scripts/build-desktop.mjs",
    "start:desktop": "electron .ido-build/desktop/app",
    "pack:desktop": "electron-builder --config packages/desktop/builder.config.json --publish never",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "coordination:read": "node scripts/read-github-coordination.mjs",
    "build:ido": "node scripts/build-ido.mjs",
    "check:ido": "npm run build:common-ui && tsc -p tsconfig.ido.json --noEmit && tsc -p tsconfig.ui.json",
    "test:ido": "npm run build:common-ui && node --import tsx --test packages/*/test/*.test.ts packages/*/test/*.test.mjs",
    "verify:ido": "npm run check:ido && npm run build:ido && npm run test:ido",
    "pack:ido": "node scripts/pack-ido.mjs",
    "smoke:ido": "node scripts/ido-browser-smoke.mjs && node scripts/ido-preview-browser-smoke.mjs",
    "smoke:ido:pack": "node scripts/ido-pack-smoke.mjs",
    "build": "npm run build:ido",
    "check": "npm run check:ido",
    "test": "npm run test:ido",
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,mjs,css,html}\" \"packages/*/test/**/*.{ts,mjs}\" \"scripts/*.mjs\" \"docs/*.md\" \"*.{js,json,md}\" \".github/workflows/*.yml\"",
    "verify": "npm run verify:ido && npm run lint && npm audit",
    "build:common-ui": "npm run build --workspace @ido/common-ui",
    "build:common": "npm run build --workspace @ido/common"
  }
}
