{
  "name": "personal-context-hub",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Local-first MCP hub for bounded personal context and connected-service workflows.",
  "scripts": {
    "auth:traq": "node src/integrations/traq/auth.mjs",
    "auth:discord": "node scripts/store-discord-token.mjs",
    "auth:discord:voice:instance": "node scripts/discord-voice-instance.mjs auth",
    "auth:discord:user": "bash scripts/run-discord-rpc-windows.sh auth",
    "start": "node src/integrations/traq/server.mjs",
    "start:discord": "node src/integrations/discord-bot/server.mjs",
    "start:discord:voice": "node --env-file-if-exists=.env src/runtime/discord-voice/server.mjs",
    "start:discord:voice:instance": "node scripts/discord-voice-instance.mjs start",
    "smoke": "node scripts/smoke.mjs",
    "smoke:discord": "node scripts/discord-smoke.mjs",
    "smoke:discord:voice:local": "node scripts/discord-voice-local-smoke.mjs",
    "smoke:discord:voice:mock": "node --test test/discord-voice-mock-e2e.test.mjs",
    "smoke:discord:voice:codex": "node --env-file-if-exists=.env scripts/discord-voice-codex-smoke.mjs",
    "smoke:discord:voice:power": "node --env-file-if-exists=.env scripts/discord-voice-power-smoke.mjs",
    "doctor:discord:voice": "node scripts/discord-voice-setup-doctor.mjs",
    "smoke:discord:user": "bash scripts/run-discord-rpc-windows.sh smoke",
    "smoke:mail:thunderbird": "node scripts/thunderbird-mail-smoke.mjs",
    "inspect:public": "node scripts/inspect-public-context.mjs",
    "coordination:read": "node scripts/read-github-coordination.mjs",
    "inspect:mail:thunderbird": "node scripts/inspect-thunderbird-mail.mjs",
    "inspect:discord": "node scripts/inspect-discord-auth.mjs",
    "inspect:discord:voice": "node --env-file-if-exists=.env scripts/inspect-discord-voice-config.mjs",
    "inspect:discord:voice:instance": "node scripts/discord-voice-instance.mjs inspect",
    "inspect:discord:voice:offline": "node scripts/inspect-discord-voice-config.mjs --offline",
    "inspect:discord:user": "bash scripts/run-discord-rpc-windows.sh inspect",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.{js,json,md}\" \"desktop/**/*.{mjs,cjs,js,html,json}\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.{js,json,md}\" \"desktop/**/*.{mjs,cjs,js,html,json}\"",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.mjs --test-coverage-lines=60 --test-coverage-branches=60 --test-coverage-functions=30 test/*.test.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:coverage && npm audit",
    "check": "node scripts/check-syntax.mjs",
    "smoke:discord:voice:idd": "node --env-file-if-exists=.env scripts/discord-voice-idd-smoke.mjs",
    "smoke:discord:voice:audio": "node --env-file-if-exists=.env scripts/discord-voice-audio-smoke.mjs",
    "smoke:discord:voice:conversation": "node --env-file-if-exists=.env scripts/discord-voice-conversation-smoke.mjs",
    "smoke:discord:voice:cancel": "node --env-file-if-exists=.env scripts/discord-voice-cancel-smoke.mjs",
    "smoke:discord:voice:preview": "node scripts/discord-voice-preview-smoke.mjs",
    "smoke:discord:voice:loop": "node scripts/discord-voice-loop-smoke.mjs",
    "smoke:discord:voice:live": "node --env-file-if-exists=.env scripts/discord-voice-live-smoke.mjs",
    "agent:ui": "node scripts/discord-agent-ui.mjs",
    "doctor:discord:agents": "node scripts/inspect-agent-host.mjs",
    "agent:pair": "node --env-file-if-exists=.env.agent scripts/discord-agent-worker.mjs pair",
    "start:discord:agent": "node --env-file-if-exists=.env.agent scripts/discord-agent-worker.mjs start",
    "smoke:discord:voice:invocation": "node --env-file-if-exists=.env scripts/discord-voice-invocation-smoke.mjs",
    "hud:build": "npm --prefix ui run build",
    "hud:install": "npm --prefix ui ci",
    "smoke:discord:voice:hud": "node scripts/voice-hud-browser-smoke.mjs",
    "start:studio": "node --env-file-if-exists=.env src/runtime/browser/server.mjs",
    "studio:demo:init": "node scripts/studio-demo-init.mjs",
    "smoke:studio": "node scripts/studio-browser-smoke.mjs",
    "smoke:studio:live": "node scripts/studio-live-smoke.mjs",
    "agent:desktop": "electron desktop/main.mjs",
    "agent:desktop:prepare": "node scripts/prepare-agent-desktop.mjs",
    "agent:desktop:package": "npm run agent:desktop:prepare && npm --prefix .desktop-build/app install --omit=dev --ignore-scripts && electron-builder --config desktop/builder.config.json --win --publish never",
    "agent:desktop:smoke": "node scripts/agent-desktop-smoke.mjs",
    "build:ido": "node scripts/build-ido.mjs",
    "check:ido": "tsc -p tsconfig.ido.json --noEmit && tsc -p packages/dashboard/tsconfig.json",
    "test:ido": "node --import tsx --test packages/*/test/*.test.ts",
    "verify:ido": "npm run check:ido && npm run build:ido && npm run test:ido",
    "pack:ido": "node scripts/pack-ido.mjs",
    "smoke:ido": "node scripts/ido-browser-smoke.mjs",
    "smoke:ido:pack": "node scripts/ido-pack-smoke.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.149.0",
    "discord.js": "^14.27.0",
    "openai": "^7.15.0",
    "opusscript": "^0.0.8",
    "playwright": "^1.63.0",
    "prism-media": "^1.3.5",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
