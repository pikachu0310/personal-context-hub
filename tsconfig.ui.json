{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "packages/*/src/**/*.tsx",
    "packages/*/src/ui/**/*.ts",
    "packages/*/src/web/**/*.ts",
    "packages/plugin-discord/src/activity/web/**/*.ts"
  ]
}
