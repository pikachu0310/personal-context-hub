# Copy this file to .env.voice.<profile>. Keep the copy ignored and local.
# Shared values such as OPENAI_API_KEY may stay in the ignored base .env.
PERSONAL_CONTEXT_VOICE_GUILD_ID=11111111111111111
PERSONAL_CONTEXT_VOICE_CHANNEL_ID=22222222222222222
PERSONAL_CONTEXT_VOICE_TEXT_CHANNEL_ID=33333333333333333
PERSONAL_CONTEXT_VOICE_USER_ID=44444444444444444
PERSONAL_CONTEXT_VOICE_WORKDIR=/home/example/github/project

# Every instance must use distinct credential, meeting state, and isolated Codex paths.
PERSONAL_CONTEXT_DISCORD_TOKEN_PATH=/home/example/.local/share/personal-context-hub/discord-bot-example.json
PERSONAL_CONTEXT_VOICE_STATE_PATH=/home/example/.local/state/personal-context-hub/discord-voice-example.json
PERSONAL_CONTEXT_VOICE_ISOLATED_CODEX_HOME=/home/example/.local/state/personal-context-hub/discord-voice-example-codex-home
PERSONAL_CONTEXT_VOICE_TRANSCRIPT_ARCHIVE_DIR=/home/example/.local/state/personal-context-hub/discord-voice-transcripts

PERSONAL_CONTEXT_VOICE_MODE=meeting
PERSONAL_CONTEXT_VOICE_LISTEN_TO_EVERYONE=true
PERSONAL_CONTEXT_VOICE_POWER_MODE=true
PERSONAL_CONTEXT_VOICE_CODEX_SANDBOX=danger-full-access
PERSONAL_CONTEXT_VOICE_CODEX_MODEL=gpt-5.6-sol
PERSONAL_CONTEXT_VOICE_CODEX_REASONING_EFFORT=high
PERSONAL_CONTEXT_VOICE_IMMEDIATE_REACTIONS=true
PERSONAL_CONTEXT_VOICE_SILENT_MESSAGES=true
PERSONAL_CONTEXT_VOICE_TRANSCRIPT_ARCHIVE_DISCORD=true
PERSONAL_CONTEXT_VOICE_TRANSCRIPT_ARCHIVE_FLUSH_INTERVAL_MS=60000
PERSONAL_CONTEXT_VOICE_TTS_SPEED=2

# Idobata development loop: comma-separated Discord IDs for additional operators.
PERSONAL_CONTEXT_VOICE_OPERATOR_IDS=
PERSONAL_CONTEXT_VOICE_REQUIRE_WAKE_WORD=true
PERSONAL_CONTEXT_VOICE_OBSERVER_MODEL=gpt-5.6-sol
PERSONAL_CONTEXT_VOICE_OBSERVER_REASONING_EFFORT=low
PERSONAL_CONTEXT_VOICE_TASK_MODEL=gpt-5.6-sol
PERSONAL_CONTEXT_VOICE_TASK_REASONING_EFFORT=medium
PERSONAL_CONTEXT_VOICE_COMPLEX_TASK_MODEL=gpt-5.6-sol
PERSONAL_CONTEXT_VOICE_COMPLEX_TASK_REASONING_EFFORT=medium
