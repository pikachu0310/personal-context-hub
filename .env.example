# Discord Voice -> Codex. Copy to an ignored local environment loader.
# The offline inspector does not load this file; export its five public values.
OPENAI_API_KEY=replace-with-openai-api-key
PERSONAL_CONTEXT_VOICE_GUILD_ID=11111111111111111
PERSONAL_CONTEXT_VOICE_CHANNEL_ID=22222222222222222
PERSONAL_CONTEXT_VOICE_TEXT_CHANNEL_ID=33333333333333333
PERSONAL_CONTEXT_VOICE_USER_ID=44444444444444444
PERSONAL_CONTEXT_VOICE_WORKDIR=/home/example/github/project
# Authentication source only. Its config.toml is not inherited.
PERSONAL_CONTEXT_VOICE_CODEX_HOME=/mnt/c/Users/example/.codex

# Optional tuning
# Defaults beside PERSONAL_CONTEXT_VOICE_STATE_PATH with mode 0700.
# PERSONAL_CONTEXT_VOICE_ISOLATED_CODEX_HOME=/home/example/.local/state/personal-context-hub/discord-voice-codex-home
# PERSONAL_CONTEXT_VOICE_CODEX_MODEL=gpt-5.6-terra
# Sandbox choices: read-only, workspace-write
# PERSONAL_CONTEXT_VOICE_CODEX_SANDBOX=workspace-write
# PERSONAL_CONTEXT_VOICE_TTS_VOICE=marin
# PERSONAL_CONTEXT_VOICE_SILENCE_MS=1000
# PERSONAL_CONTEXT_VOICE_STT_TIMEOUT_MS=120000
# PERSONAL_CONTEXT_VOICE_CODEX_TIMEOUT_MS=900000
# PERSONAL_CONTEXT_VOICE_TTS_TIMEOUT_MS=120000
# PERSONAL_CONTEXT_VOICE_PLAYBACK_TIMEOUT_MS=300000
# PERSONAL_CONTEXT_VOICE_DISCORD_TIMEOUT_MS=30000
